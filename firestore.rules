rules_version = '2';
// 이심전심 환자 DB (v3.19, 시연용 — PIN 없음). Firebase 콘솔 > Firestore > 규칙 에 붙여 넣는다.
// 이 사이트에서 익명 로그인한 사용자만 읽고 쓸 수 있다. 실제 환자 정보는 넣지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{pid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if false;
      match /data/{part} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && part in ['history', 'learn', 'exp']
          && request.resource.data.json is string;
      }
    }
  }
}
