# Keep your existing .env. Add only these after training succeeds.
V7_ENABLED=false
FT_GENERATOR_MODEL=
FT_MODEL_STATE=training/artifacts/ft_model.json
PHRASE_BANK_PATH=research/phrase_memory/common_phrase_bank.jsonl
PHRASE_MEMORY_LIMIT=6

# Existing v6.3 settings remain:
ENSEMBLE_MODE=context_quality
ENSEMBLE_MIN_VALID=6
ENSEMBLE_CONTEXT_THRESHOLD=0.72
ENSEMBLE_INTENT_THRESHOLD=0.72
DIVERSITY_GENERATION_COUNT=8
