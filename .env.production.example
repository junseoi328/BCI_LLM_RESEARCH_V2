# Do NOT commit the real key.
OPENAI_API_KEY=sk-REPLACE_ME

MOCK_MODE=false
BCI_DEMO_MODE=true
LOCAL_BCI_GENERATOR_ENABLED=false

GENERATOR_MODEL=gpt-5.6-luna
RANKER_MODEL=gpt-5.6-luna
GENERATION_COUNT=16

OPENAI_TIMEOUT_SEC=45
OPENAI_MAX_RETRIES=2
ALLOW_LOCAL_FALLBACK=true
DEBUG_MODE=false

PIPELINE_VERSION=0.6.0-web-deploy
GENERATOR_PROMPT_VERSION=generator-v2+context-diversity-v2
RANKER_PROMPT_VERSION=ranker-v2
