# Runtime
APP_ENV=development
DEBUG_MODE=false
MOCK_MODE=true

# OpenAI - never commit the real key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_GENERATOR_MODEL=gpt-5.6-luna
OPENAI_RANKER_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SEC=8
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1600

# Pipeline
GENERATION_COUNT=16
DISPLAY_TOP_K=3
MAX_EEG_HYPOTHESES=5
USE_LLM_RANKER=true
ALLOW_LOCAL_FALLBACK=false
DIVERSITY_SIMILARITY_THRESHOLD=0.90

# Language ranking weights
WEIGHT_CONTEXT=0.50
WEIGHT_INTENT=0.20
WEIGHT_NATURALNESS=0.20
WEIGHT_PARTNER=0.10

# EEG-language heuristic fusion
WEIGHT_EEG=0.35
EEG_SOFTMAX_TEMPERATURE=1.0

# Hybrid decision
HYBRID_MIN_TOP_SCORE=0.62
HYBRID_MIN_MARGIN=0.08

# Logging
ENABLE_EXPERIMENT_LOG=true
EXPERIMENT_LOG_PATH=logs/experiment.jsonl

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reproducibility
PIPELINE_VERSION=0.2.0
GENERATOR_PROMPT_VERSION=generator-v2
RANKER_PROMPT_VERSION=ranker-v2
